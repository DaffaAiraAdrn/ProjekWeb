APP_NAME="DF_137 Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://your-subdomain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — Supabase (session pooler, port 5432)
# ---------------------------------------------------------------------------
# Values come from: Supabase dashboard -> Connect -> Connection string ->
# "Session pooler" tab. Session mode (5432) is used rather than transaction
# mode (6543) because it is IPv4-reachable and supports prepared statements,
# so PDO and `php artisan migrate` work without special handling.
# SSL is not configured here: config/database.php already forces sslmode=require.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_SECRET_ROUTE=vault-access

# Seeded into the admins table by DatabaseSeeder.
ADMIN_NAME="Your Name"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Required by public/extract.php, which unpacks the deploy archive. That
# endpoint is public, so it stays disabled until this is set to a long
# random string: php -r "echo bin2hex(random_bytes(24));"
DEPLOY_TOKEN=

# Required by public/migrate.php. Leave empty to keep that endpoint disabled.
MIGRATE_TOKEN=
